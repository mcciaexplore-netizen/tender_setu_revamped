PORT=3000
NODE_ENV=development

# Neon Database Configuration
DATABASE_URL=postgres://user:password@endpoint.neon.tech/dbname?sslmode=require
# Generate a unique value of at least 32 characters. Never commit the real value.
JWT_SECRET=replace_with_a_unique_secret_of_at_least_32_characters
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Optional: signup/login emails that should have the administrator role.
ADMIN_EMAILS=

# Gemini API Key for AI tender extraction (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
