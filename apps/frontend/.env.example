# Optional. Leave unset in normal use: the built app is served by the backend on
# the same origin, and `npm run dev:frontend` proxies /api to the backend.
# Copy to .env.local only if you need a custom setup.

# Absolute API URL (only when the API is on a different origin than the UI).
# VITE_API_URL=

# Dev server proxy target if the backend is not on port 3000.
# VITE_PROXY_TARGET=http://localhost:3000
